pipeline {
  agent any

  environment {
    DOCKER_IMAGE = 'dlsqja3436/frontend'
    TAG = 'latest'
    CONTAINER_NAME = 'frontend'
    EC2_HOST = 'k13a201.p.ssafy.io'
    HAS_FRONTEND_CHANGES = 'false'
  }

  stages {
    stage('Check Changes') {
      steps {
        script {
          try {
            // Git 변경사항 확인 (전체 저장소 기준)
            def changes = sh(
              script: 'git diff --name-only $GIT_PREVIOUS_SUCCESSFUL_COMMIT $GIT_COMMIT 2>/dev/null || git diff --name-only HEAD~1 HEAD 2>/dev/null || echo ""',
              returnStdout: true
            ).trim()
            
            if (changes) {
              echo "변경된 파일 목록:\n${changes}"
              def changedFiles = changes.split('\n')
              def hasFrontendChanges = changedFiles.any { file ->
                file.trim().startsWith('frontend/jellypaw-web/')
              }
              
              if (hasFrontendChanges) {
                env.HAS_FRONTEND_CHANGES = 'true'
                echo "✅ frontend/jellypaw-web 폴더에 변경사항이 있습니다. 배포를 진행합니다."
              } else {
                echo "❌ frontend/jellypaw-web 폴더에 변경사항이 없습니다. 배포를 건너뜁니다."
                currentBuild.result = 'ABORTED'
                error("No changes in frontend/jellypaw-web folder")
              }
            } else {
              // 첫 빌드이거나 변경사항을 확인할 수 없는 경우
              echo "⚠️ 변경사항을 확인할 수 없습니다. 배포를 진행합니다."
              env.HAS_FRONTEND_CHANGES = 'true'
            }
          } catch (Exception e) {
            echo "변경사항 확인 중 오류 발생: ${e.message}"
            echo "배포를 진행합니다."
            env.HAS_FRONTEND_CHANGES = 'true'
          }
        }
      }
    }

    stage('Build Frontend') {
      when {
        expression { env.HAS_FRONTEND_CHANGES == 'true' }
      }
      agent {
        docker {
          image 'node:20.19.1'
        }
      }
      steps {
        // .env 내용 주입
        withCredentials([file(credentialsId: 'frontend-env', variable: 'FRONT_ENV_FILE')]) {
          sh '''
            cp "$FRONT_ENV_FILE" .env
            echo "✅ .env 파일 복사 완료"
            npm install
            npm run build
          '''
        }
        archiveArtifacts artifacts: 'dist/**', fingerprint: true
      }
    }

    stage('Build and Push Docker Image') {
      when {
        expression { env.HAS_FRONTEND_CHANGES == 'true' }
      }
      agent any
      steps {
        withCredentials([
          usernamePassword(
            credentialsId: 'dockerhub-creds',
            usernameVariable: 'DOCKERHUB_USERNAME',
            passwordVariable: 'DOCKERHUB_PASSWORD'
          )
        ]) {
          sh '''
            echo "${DOCKERHUB_PASSWORD}" | docker login -u "${DOCKERHUB_USERNAME}" --password-stdin
            docker build -t ${DOCKER_IMAGE}:${TAG} .
            docker push ${DOCKER_IMAGE}:${TAG}
          '''
        }
      }
    }

    stage('Deploy to EC2') {
      when {
        expression { env.HAS_FRONTEND_CHANGES == 'true' }
      }
      agent any
      steps {
        withCredentials([
          sshUserPrivateKey(
            credentialsId: 'ec2-ssh-key',
            keyFileVariable: 'KEYFILE',
            usernameVariable: 'EC2_USERNAME'
          ),
          usernamePassword(
            credentialsId: 'dockerhub-creds',
            usernameVariable: 'DOCKERHUB_USERNAME',
            passwordVariable: 'DOCKERHUB_PASSWORD'
          )
        ]) {
          sh '''
            chmod 600 "$KEYFILE"
            ssh -o StrictHostKeyChecking=no -i "$KEYFILE" $EC2_USERNAME@$EC2_HOST '
              echo "'${DOCKERHUB_PASSWORD}'" | docker login -u "'${DOCKERHUB_USERNAME}'" --password-stdin
              docker stop "'${CONTAINER_NAME}'" || true
              docker rm "'${CONTAINER_NAME}'" || true
              docker pull "'${DOCKER_IMAGE}:${TAG}'"
              docker run --name "'${CONTAINER_NAME}'" -d -p 3000:80 "'${DOCKER_IMAGE}:${TAG}'"
            '
          '''
        }
      }
    }
  }
}
