{
  "index": {
    "max_ngram_diff": 8
  },
  "analysis": {
    "normalizer": {
      "lower_norm": {
        "type": "custom",
        "filter": ["lowercase", "asciifolding"]
      }
    },
    "tokenizer": {
      "ngram_tokenizer": {
        "type": "ngram",
        "min_gram": 2,
        "max_gram": 10,
        "token_chars": ["letter", "digit"]
      },
      "edge_tokenizer": {
        "type": "edge_ngram",
        "min_gram": 1,
        "max_gram": 15,
        "token_chars": ["letter", "digit"]
      },
      "nori_tokenizer": {
        "type": "nori_tokenizer",
        "decompound_mode": "mixed"
      }
    },
    "filter": {
      "nori_part_of_speech": {
        "type": "nori_part_of_speech",
        "stoptags": [
          "E",
          "IC",
          "J",
          "MAG",
          "MAJ",
          "MM",
          "SP",
          "SSC",
          "SSO",
          "SC",
          "SE",
          "XPN",
          "XSA",
          "XSN",
          "XSV",
          "UNA",
          "NA",
          "VSV"
        ]
      },
      "nori_readingform": {
        "type": "nori_readingform"
      }
    },
    "analyzer": {
      "ngram_analyzer": {
        "type": "custom",
        "tokenizer": "ngram_tokenizer",
        "filter": ["lowercase", "asciifolding"]
      },
      "edge_analyzer": {
        "type": "custom",
        "tokenizer": "edge_tokenizer",
        "filter": ["lowercase", "asciifolding"]
      },
      "search_analyzer_std": {
        "type": "custom",
        "tokenizer": "standard",
        "filter": ["lowercase", "asciifolding"]
      },
      "korean_nori": {
        "type": "custom",
        "tokenizer": "nori_tokenizer",
        "filter": ["lowercase", "nori_readingform", "nori_part_of_speech"]
      }
    }
  }
}
